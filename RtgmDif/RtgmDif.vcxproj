    <CudaCompile Include="NVEnc\NVEncCore\NVEncFilterDenoiseFFT3D16FP32.cu" />
    <CudaCompile Include="NVEnc\NVEncCore\NVEncFilterDenoiseFFT3D16FP16.cu" />
    <CudaCompile Include="NVEnc\NVEncCore\NVEncFilterNnedi.cu" />
