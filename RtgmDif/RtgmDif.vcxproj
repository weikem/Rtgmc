<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{2F8D1A64-7C93-4E51-B0A7-5D6E93F1C482}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>RtgmDif</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- cudaver.props is a local copy: this project and RtgmDifTest are meant to be lifted out of
       the NVEnc tree and must not reach back into it. -->
  <Import Project="cudaver.props" />
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <!-- Both projects build into their own tree, so the pair can be moved anywhere together. -->
    <OutDir>$(ProjectDir)build\</OutDir>
    <IntDir>$(ProjectDir)build\obj\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>
      </PrecompiledHeader>
      <Optimization>Full</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- No export define: the only two exported symbols carry __declspec(dllexport) on their
           definitions in RtgmDif.cpp, and RtgmDif.h has no conditional at all. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH;WIN32;NDEBUG;_CONSOLE;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Everything under NVEnc\ is this project's own copy of the NVEnc sources it compiles.
           Only what the RTGMC chain and the NVEncCore plumbing under it actually need is in
           there: no ffmpeg, no NVENC/NGX/OFFRUC SDK, no resize/crop/libplacebo. The tool that
           produced that copy lives in the NVEnc repo root (_vendor_rtgmdif.ps1) and is not
           needed to build this project. -->
      <AdditionalIncludeDirectories>.;NVEnc;NVEnc\NVEncCore;NVEnc\NVEncSDK;NVEnc\NVEncSDK\Common;NVEnc\NVEncSDK\Common\inc;NVEnc\NVEncSDK\Core;NVEnc\NVEncSDK\Core\include;$(WindowsSDK_IncludePath);$(CUDA_PATH)\include;$(DXSDK_DIR)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>NVEnc\rtgmc_config.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <DisableSpecificWarnings>4505;4512;4127</DisableSpecificWarnings>
      <FloatingPointModel>Fast</FloatingPointModel>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <StringPooling>true</StringPooling>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <OmitFramePointers>false</OmitFramePointers>
      <EnableFiberSafeOptimizations>true</EnableFiberSafeOptimizations>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <!-- The RTGMC pipeline needs the CUDA driver API (cuda.lib) plus the D3D interop entry
           points the NVEncCore infrastructure references. npp*/nvrtc are not linked at all any
           more - see cudaver.props. Everything a caller of RtgmDif needs is therefore inside
           this DLL: RtgmDifTest links the import library and cudart, nothing else. -->
      <AdditionalDependencies>cuda.lib;d3d9.lib;dxgi.lib;d3d11.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- The export list. Two names, and not one dllexport anywhere in the sources. -->
      <ModuleDefinitionFile>RtgmDif.def</ModuleDefinitionFile>
    </Link>
    <!-- The RTGMC EDI stage runs NNEDI3 by default and loads this weight file at runtime from
         the working directory / module directory. -->
    <PostBuildEvent>
      <Command>copy /y "$(ProjectDir)NVEnc\resource\nnedi3_weights.bin" "$(OutDir)" &gt; NUL</Command>
      <Message>copying nnedi3_weights.bin</Message>
    </PostBuildEvent>
    <CudaCompile>
      <TargetMachinePlatform>64</TargetMachinePlatform>
      <AdditionalIncludeDirectories>.;NVEnc;NVEnc\NVEncCore;NVEnc\NVEncSDK;NVEnc\NVEncSDK\Common;NVEnc\NVEncSDK\Common\inc;NVEnc\NVEncSDK\Core;NVEnc\NVEncSDK\Core\include;$(WindowsSDK_IncludePath);$(CUDA_PATH)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalCompilerOptions>/wd"4819" /wd"4505" /wd"4127" /FS</AdditionalCompilerOptions>
      <!-- Single arch: the RTGMC kernels are large, and the full multi-arch list blows up
           cicc memory. The rest is JIT'ed at runtime. -->
      <CodeGeneration>compute_75,compute_75</CodeGeneration>
      <AdditionalOptions>-include NVEnc\rtgmc_config.h -Wno-deprecated-gpu-targets -Xcudafe "--display_error_number --diag_suppress=negative_shift_count --diag_suppress=signed_one_bit_field --diag_suppress=expr_has_no_effect --diag_suppress=177 --diag_suppress=186 --diag_suppress=815 --diag_suppress=1444 --diag_suppress=2465 --diag_suppress=63" -allow-unsupported-compiler -std=c++17</AdditionalOptions>
      <FastMath>true</FastMath>
      <UseHostDefines>true</UseHostDefines>
    </CudaCompile>
  </ItemDefinitionGroup>

  <!-- ===================== RtgmDif ===================== -->
  <ItemGroup>
    <ClCompile Include="RtgmDif.cpp" />
    <!-- Provides the three DLL name strings NVEncCore declares, so that NVEncFilterResize.cu
         does not have to be compiled in for them (and with it the NVVFX/NGX/libplacebo chain
         and the nppig import). See the file itself. -->
    <ClCompile Include="RtgmDifDllNames.cpp" />
    <ClInclude Include="RtgmDif.h" />
    <None Include="RtgmDif.def" />
  </ItemGroup>

  <!-- ===================== NVEncCore plumbing the RTGMC chain needs ===================== -->
  <ItemGroup>
    <ClCompile Include="NVEnc\rtgmc_cmd_stub.cpp" />
    <!-- convert_csp.cpp and its five SSE2 / SSSE3 / SSE4.1 / AVX / AVX2 siblings are gone from
         the build. They are the CPU colour-space conversion table - about 300 kernels plus the
         dispatch that picks between them - and nothing here calls any of it: the three entry
         points (get_convert_csp_func, get_copy_alpha_func, get_simd_str, convert_csp.cpp:2888)
         have no caller in this tree, because every conversion RTGMC does happens on the device,
         in the cspconv kernels of NVEncFilterCspCrop.cu. They are also about 620 KB of source
         between them - convert_csp.cpp alone is 275 KB, convert_csp_avx2.cpp 185 KB - which is
         the bulk of why they must not be left in a build that never calls them.

         convert_csp.h itself stays, and has to: it declares RGY_CSP, and rgy_frame.h,
         rgy_filter.h, NVEncFilter.h and most of the rest include it. Only the string "convert"
         in the name is shared - it is a different thing from the table. -->
    <!-- Needed, and the linker is the one that says so: taking this out gives getCPUInfo (from
         rgy_env.cpp's getEnviromentInfo and rgy_log.cpp's log header) and get_cpu_info/get_mask
         (from RGYThreadAffinity::getMask) as unresolved externals. -->
    <ClCompile Include="NVEnc\NVEncCore\cpu_info.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilter.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterParam.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_bitstream.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_bitstream_avx2.cpp">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <ClCompile Include="NVEnc\NVEncCore\rgy_bitstream_avx512bw.cpp">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions512</EnableEnhancedInstructionSet>
    </ClCompile>
    <ClCompile Include="NVEnc\NVEncCore\rgy_codepage.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_def.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_env.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_err.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_hdr10plus.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_filesystem.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_filter.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_frame.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_frame_info.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_log.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_memmem.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_memmem_avx2.cpp">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
    <ClCompile Include="NVEnc\NVEncCore\rgy_memmem_avx512bw.cpp">
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions512</EnableEnhancedInstructionSet>
    </ClCompile>
    <ClCompile Include="NVEnc\NVEncCore\rgy_perf_counter.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_prm.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_simd.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_thread_affinity.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_util.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_version.cpp" />
  </ItemGroup>

  <!-- ===================== shared filter helpers used by RTGMC ===================== -->
  <ItemGroup>
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterDegrain.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterDegrainCommon.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterDegrainMV.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterDenoiseFFT3D.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\NVEncFilterRtgmcShimmerRepair.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_filter_nnedi_field.cpp" />
    <ClCompile Include="NVEnc\NVEncCore\rgy_filter_nnedi_weights.cpp" />
  </ItemGroup>

  <!-- ===================== kernels ===================== -->
  <ItemGroup>
